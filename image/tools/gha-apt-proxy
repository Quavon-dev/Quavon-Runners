#!/usr/bin/env bash
# apt's Acquire::http::Proxy-Auto-Detect: the LXC's apt proxy while it
# answers, otherwise DIRECT, so apt never breaks when the proxy is down.
ip="$(ip -4 -o addr show docker0 2>/dev/null | awk '{ sub("/.*", "", $4); print $4; exit }')"
proxy="http://${ip}:29173"
if [[ -n "$ip" && "${1:-}" =~ ^http://[A-Za-z0-9.-]*[A-Za-z](/|$) ]] \
  && curl -fsS --max-time 2 -o /dev/null "${proxy}/health" 2>/dev/null; then
  echo "$proxy"
else
  echo DIRECT
fi
