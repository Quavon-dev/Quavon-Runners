[Unit]
Description=Local %i cache for the GitHub Actions runners
After=docker.service network-online.target
Wants=network-online.target
Requires=docker.service
StartLimitIntervalSec=0

[Service]
Type=simple
ExecStart=/usr/local/bin/gha-runners _cache %i
ExecStop=/usr/bin/docker stop --time 20 gha-cache-%i
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
